{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext", // ← DEVE ser exatamente "NodeNext" (com aspas)
    "moduleResolution": "NodeNext", // ← DEVE ser exatamente "NodeNext" (com aspas)
    "allowJs": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "docs",
    ".husky"
  ]
}